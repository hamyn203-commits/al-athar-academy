# Backend Environment Variables — Wahy Wa Namaa Academy

PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb://localhost:27017/wahynamaa

# URLs
FRONTEND_URL=https://wahy-wa-namaa-academy.vercel.app
SITE_URL=https://wahy-wa-namaa-academy.vercel.app
API_PUBLIC_URL=https://wahy-wa-namaa-api.vercel.app
ALLOWED_ORIGINS=https://wahy-wa-namaa-academy.vercel.app,http://localhost:5173,http://localhost:5174

# JWT
JWT_SECRET=change-me-in-production-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_SAMESITE=Lax
# Set true only when an approved Vercel preview must call the API with credentials.
ALLOW_VERCEL_PREVIEW_ORIGINS=false

# AI (optional — OpenAI → Bedrock → Gemini → local)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# Payments — Paymob Egypt (disabled until merchant test credentials are configured)
PAYMOB_ENABLED=false
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Comma-separated Paymob online Integration IDs enabled for Unified Checkout.
PAYMOB_INTEGRATION_IDS=

# Legacy donations (optional external payment links; not automatic settlement)
STRIPE_DONATION_URL=
PAYPAL_DONATION_URL=

# Meetings
DEFAULT_MEETING_PROVIDER=jitsi
ZOOM_MEETING_BASE_URL=
GOOGLE_MEET_BASE_URL=

# LiveKit (optional live sessions)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# Production runtime readiness
# On serverless hosts use external object storage and an authenticated HTTP scheduler.
FILE_STORAGE_DRIVER=external
ENABLE_IN_PROCESS_SCHEDULER=false
CRON_SECRET=change-me-production-cron-secret

# Object storage — temporary Vercel Blob or future S3-compatible provider
# BLOB_READ_WRITE_TOKEN is injected automatically when a Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Wahy Wa Namaa <noreply@example.com>
ADMIN_EMAIL=admin@example.com
SEED_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=

# WhatsApp — choose Meta Cloud API or Twilio.
# Meta Cloud API (preferred direct provider path)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Twilio WhatsApp fallback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Push (FCM)
FCM_SERVER_KEY=

# Public launch readiness — evidence flags, not substitutes for real tests
# Keep false until the named external E2E verification has actually succeeded.
LAUNCH_MODE=public
LAUNCH_REQUIRED_FEATURES=email,paymob,livekit,whatsapp
EMAIL_DOMAIN_VERIFIED=false
EMAIL_E2E_VERIFIED=false
PAYMOB_E2E_VERIFIED=false
LIVEKIT_E2E_VERIFIED=false
WHATSAPP_E2E_VERIFIED=false
